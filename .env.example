BETMAP_ODDS_API_KEY=
BETMAP_DB_PATH=data/betmap.db
BETMAP_KELLY_FRACTION=0.25
BETMAP_MAX_BET_FRACTION=0.03
BETMAP_MAX_GAME_FRACTION=0.06
# Books you can bet at, as Odds API keys; empty = all
BETMAP_BOOKS=
# Books to pull (Odds API keys); every 10 cost one region's worth of credits. Empty = "us" region.
BETMAP_PULL_BOOKS=fanduel,draftkings,betmgm,betrivers,lowvig,pinnacle,kalshi,polymarket,novig,underdog
# Exchange taker fees as book:rate, charged as rate x price x (1 - price) per $1 contract
BETMAP_EXCHANGE_FEES=kalshi:0.07
